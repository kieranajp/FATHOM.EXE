grow_vertical = 2

[node name="V" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Panel/V"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.733333, 0, 1)
theme_override_font_sizes/font_size = 24
text = "THE SALTY TANKARD TAVERN"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Panel/V"]
modulate = Color(1, 1, 1, 0.7)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "A smoky hall filled with sailors, card players, and the smell of salted cod and cheap rum."
horizontal_alignment = 1
autowrap_mode = 3

[node name="BarkeepPanel" type="VBoxContainer" parent="Panel/V"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BarkeepHeader" type="Label" parent="Panel/V/BarkeepPanel"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.733333, 0, 1)
text = "🧑‍✈️ THE BARKEEP"
horizontal_alignment = 1

[node name="Actions" type="HBoxContainer" parent="Panel/V/BarkeepPanel"]
layout_mode = 2
